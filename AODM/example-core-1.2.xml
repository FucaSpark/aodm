<?xml version="1.0" encoding="UTF-8"?>

<aodm:knowledge version="1.2" xmlns:aodm="http://fucaspark.com/aodm/1.2">

  <aodm:entity id="engine" type="component" label="Engine"
               hash="sha256:2a405ca8706ec21cb1e55539b1c514daf94b3f6cb304328b3df662b04b80c1d7">
    Internal combustion engine, 4-cylinder.
    <aodm:source uri="https://example.com/spec-sheet-24" title="Engineering Test Report 24"
                 asserted="2025-11-02" retrieved="2026-01-15"/>
    <aodm:confidence value="0.95"/>
  </aodm:entity>

  <aodm:entity id="fuel" type="substance" label="Fuel"/>
  <aodm:entity id="coolant" type="substance" label="Coolant"/>

  <aodm:relationship id="engine-requires-fuel" type="requires"
                     subject="engine" predicate="requires" object="fuel"
                     valid-from="2024-01-01">
    <aodm:confidence value="1.0"/>
  </aodm:relationship>

  <aodm:relationship id="engine-not-coolant" type="requires"
                     subject="engine" predicate="requires" object="coolant"
                     polarity="negative">
    <aodm:source title="Design Review 2026-02"/>
    <aodm:confidence value="0.88"/>
  </aodm:relationship>

  <aodm:fact id="temp-rise" about="engine" valid-from="2026-01-15">
    Temperature rise under sustained load.
    <aodm:value number="1.2" unit="Cel" tolerance="0.1"/>
    <aodm:source uri="https://example.com/report-24" retrieved="2026-01-15"/>
    <aodm:confidence value="0.9"/>
  </aodm:fact>

  <aodm:fact id="operating-pressure" about="engine">
    Nominal operating pressure envelope.
    <aodm:value min="5" max="10" unit="bar"/>
    <aodm:source uri="https://example.com/spec-sheet-24"/>
  </aodm:fact>

  <aodm:fact id="temp-rise-legacy" about="engine"
             valid-from="2024-01-01" valid-to="2026-01-14">
    Temperature rise under sustained load, pre-revision baseline.
    <aodm:value number="1.1" unit="Cel"/>
    <aodm:confidence value="0.8"/>
  </aodm:fact>

  <aodm:fact id="failure-risk" about="engine"
             derived-from="risk-rule temp-rise">
    Elevated failure risk under sustained load.
    <aodm:confidence value="0.7" method="rule-inference"/>
  </aodm:fact>

  <aodm:rule id="risk-rule" valid-from="2026-01-01">
    <aodm:condition ref="temp-rise"/>
    <aodm:condition ref="operating-pressure"/>
    <aodm:conclusion ref="failure-risk"/>
    <aodm:source title="Reliability Engineering Handbook, 4th ed."/>
    <aodm:confidence value="0.7" method="model-estimate"/>
  </aodm:rule>

</aodm:knowledge>
